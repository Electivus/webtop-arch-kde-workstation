#!/usr/bin/env python3
"""Prepare vendor applications in the user's persistent home."""
import argparse
import base64
from datetime import datetime, timezone
import fcntl
from functools import cmp_to_key
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

PERSONAL_HOME = Path.home()
STATE = PERSONAL_HOME / ".local/state/electivus/preparation.json"
CACHE = PERSONAL_HOME / ".cache/electivus/downloads"
APPS = PERSONAL_HOME / ".local/share/electivus/apps"


def safe_message(message):
    """Keep the application/step failure useful without publishing proxy inputs."""
    private = set()
    for key in ("http_proxy", "https_proxy", "HTTP_PROXY", "HTTPS_PROXY"):
        address = os.environ.get(key)
        if not address:
            continue
        private.add(address)
        try:
            proxy = urllib.parse.urlsplit(address)
            for value in (proxy.username, proxy.password, proxy.hostname):
                if value:
                    private.update((value, urllib.parse.unquote(value)))
            if proxy.username and proxy.password:
                credentials = urllib.parse.unquote(proxy.username) + ":" + urllib.parse.unquote(proxy.password)
                private.add(base64.b64encode(credentials.encode()).decode())
        except ValueError:
            pass
    if private:
        message = re.sub("|".join(re.escape(value) for value in sorted(private, key=len, reverse=True)),
                         "[private]", str(message))
    message = re.sub(r"https?://[^\s<>\"']+", "[endpoint]", str(message))
    return re.sub(r"-----BEGIN [^-]+-----.*?-----END [^-]+-----", "[certificate omitted]", message, flags=re.S)


def configuration():
    result = {"repositories": {}, "apps": []}
    for path in sorted(Path("/etc/electivus/applications.d").glob("*.json")):
        entry = read_json(path)
        result["repositories"].update(entry.get("repositories", {}))
        result["apps"].extend(entry.get("apps", []))
        if "salesforce" in entry:
            result["salesforce"] = entry["salesforce"]
    return result


def now():
    return datetime.now(timezone.utc).isoformat()


def read_json(path, default=None):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return default


def write_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as output:
        json.dump(value, output, indent=2)
        output.flush()
        os.fsync(output.fileno())
        temporary = Path(output.name)
    temporary.replace(path)


def save(state, step, **details):
    if step != "download":
        state.pop("bytes", None)
        state.pop("totalBytes", None)
    state.update(state="running", step=step, updated=now(), **details)
    state.pop("error", None)
    write_json(STATE, state)
    print(state.get("app", "Applications") + ": " + step, file=sys.stderr, flush=True)


def sha256(path):
    with path.open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def run(*args, **kwargs):
    result = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, **kwargs)
    if result.returncode:
        raise RuntimeError(result.stderr.decode(errors="replace").strip() or "command failed: " + args[0])
    return result.stdout


def fetch(url, destination):
    with urllib.request.urlopen(url, timeout=45) as response, destination.open("wb") as output:
        shutil.copyfileobj(response, output)


def fields(text):
    result = {}
    name = None
    for line in text.splitlines():
        if line.startswith(" ") and name:
            result[name] += "\n" + line.strip()
        elif ":" in line:
            name, value = line.split(":", 1)
            result[name] = value.strip()
    return result


def resolve_deb(app, repository):
    """Authenticate the APT index, then follow its package SHA-256."""
    with tempfile.TemporaryDirectory(dir=CACHE) as temporary:
        directory = Path(temporary)
        os.chmod(directory, 0o700)
        fetch(repository["keyUrl"], directory / "vendor.asc")
        run("gpg", "--batch", "--homedir", str(directory), "--import", str(directory / "vendor.asc"))
        exported = run("gpg", "--batch", "--homedir", str(directory), "--export", repository["fingerprint"])
        if not exported:
            raise RuntimeError("Vendor signing key fingerprint did not match")
        (directory / "vendor.gpg").write_bytes(exported)
        base = repository["url"]
        fetch(base + "dists/stable/Release", directory / "Release")
        fetch(base + "dists/stable/Release.gpg", directory / "Release.gpg")
        run("gpgv", "--homedir", str(directory), "--keyring", str(directory / "vendor.gpg"),
            str(directory / "Release.gpg"), str(directory / "Release"))
        release = fields((directory / "Release").read_text())
        index_path = "main/binary-amd64/Packages"
        entries = [line.split() for line in release["SHA256"].splitlines() if line.strip()]
        digest, size, _ = next(entry for entry in entries if entry[2] == index_path)
        fetch(base + "dists/stable/" + index_path, directory / "Packages")
        packages = directory / "Packages"
        if packages.stat().st_size != int(size) or sha256(packages) != digest:
            raise RuntimeError("Vendor package index integrity check failed")
        candidates = [entry for entry in map(fields, packages.read_text().split("\n\n"))
                      if entry.get("Package") == app["package"] and entry.get("Architecture") == "amd64"]
        # Microsoft's signed index includes older versions, in ascending order.
        package = max(candidates, key=cmp_to_key(lambda a, b: int(run("vercmp", a["Version"], b["Version"]))))
        filename = package["Filename"]
        prefix = "pool/main/" + app["package"][0] + "/" + app["package"] + "/"
        if not filename.startswith(prefix) or ".." in filename or not re.fullmatch(r"[a-f0-9]{64}", package["SHA256"]):
            raise RuntimeError("Unexpected vendor package location or hash")
        return {"version": package["Version"], "source": base + filename, "size": int(package["Size"]),
                "sha256": package["SHA256"], "signingKey": repository["fingerprint"], "architecture": "amd64",
                "indexSha256": digest, "resolvedAt": now()}


def download(manifest, state):
    destination = CACHE / (manifest["sha256"] + ".deb")
    if destination.is_file() and sha256(destination) == manifest["sha256"]:
        return destination
    partial = destination.with_suffix(".part")
    offset = partial.stat().st_size if partial.exists() else 0
    if offset > manifest["size"]:
        partial.unlink()
        offset = 0
    save(state, "download", bytes=offset, totalBytes=manifest["size"])
    if offset < manifest["size"]:
        request = urllib.request.Request(manifest["source"], headers={"Range": "bytes=" + str(offset) + "-"} if offset else {})
        with urllib.request.urlopen(request, timeout=45) as response:
            resume = offset and response.status == 206 and response.headers.get("Content-Range", "").startswith("bytes " + str(offset) + "-")
            if not resume:
                offset = 0
            with partial.open("ab" if resume else "wb") as output:
                reported = 0.0
                while chunk := response.read(1024 * 1024):
                    output.write(chunk)
                    offset += len(chunk)
                    if offset > manifest["size"]:
                        raise RuntimeError("Package exceeds its signed size")
                    if time.monotonic() - reported >= 1:
                        state.update(bytes=offset, updated=now())
                        write_json(STATE, state)
                        print(state["app"] + ": download " + str(offset * 100 // manifest["size"]) + "%", file=sys.stderr, flush=True)
                        reported = time.monotonic()
    if partial.stat().st_size != manifest["size"] or sha256(partial) != manifest["sha256"]:
        partial.unlink(missing_ok=True)
        raise RuntimeError("Package integrity check failed; retry preparation")
    partial.replace(destination)
    return destination


def promote(staging, root, manifest, identifier):
    write_json(staging / "manifest.json", manifest)
    target = root / "versions" / identifier
    if target.exists():
        previous = read_json(target / "manifest.json")
        if not previous or previous["version"] != manifest["version"]:
            raise RuntimeError("Conflicting application version directory")
        manifest = previous
    else:
        staging.rename(target)
    pending = root / "current.new"
    pending.unlink(missing_ok=True)
    pending.symlink_to(Path("versions") / identifier)
    pending.replace(root / "current")
    return manifest


def install_deb(app, artifact, manifest):
    root = APPS / app["id"]
    versions = root / "versions"
    versions.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=".install-", dir=versions) as temporary:
        staging = Path(temporary)
        members = run("ar", "t", str(artifact)).decode().splitlines()
        data = next(member for member in members if member in {"data.tar.xz", "data.tar.gz", "data.tar.zst"})
        compression = {"data.tar.xz": "-J", "data.tar.gz": "-z", "data.tar.zst": "--zstd"}[data]
        producer = subprocess.Popen(["ar", "p", str(artifact), data], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        try:
            strip = str(len(app["extract"].split("/")))
            unpacked = subprocess.run(["tar", compression, "-xf", "-", "-C", str(staging),
                                       "--strip-components=" + strip, "--no-same-owner", app["extract"]],
                                      stdin=producer.stdout, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            producer.stdout.close()
            _, error = producer.communicate()
            if producer.returncode or unpacked.returncode:
                raise RuntimeError((error + unpacked.stderr).decode(errors="replace"))
        finally:
            if producer.poll() is None:
                producer.kill()
                producer.wait()
        actual = run(str(staging / app["executable"]), "--version").decode().strip()
        version = manifest["version"].rsplit("-", 1)[0]
        if app["id"] == "chrome":
            matches = actual == "Google Chrome " + version
        else:
            matches = actual.splitlines()[0] in {version, version + "-insider"}
        if not matches:
            raise RuntimeError("Installed application version does not match the signed package: " + actual)
        installed = dict(manifest, installedAt=now(), actualVersion=actual)
        return promote(staging, root, installed, manifest["sha256"])


def installed_deb(app):
    current = APPS / app["id"] / "current"
    installed = read_json(current / "manifest.json")
    if installed:
        actual = run(str(current / app["executable"]), "--version").decode().strip()
        if actual != installed["actualVersion"]:
            raise RuntimeError("Persisted " + app["id"] + " is not compatible with this image")
    return installed


def prepare_deb(app, repository, state, update=False):
    installed = installed_deb(app)
    if update:
        save(state, "resolve")
        selected = resolve_deb(app, repository)
        write_json(CACHE / (app["id"] + "-source.json"), selected)
        if installed and installed["sha256"] != selected["sha256"]:
            installed = None
    if not installed:
        source = CACHE / (app["id"] + "-source.json")
        manifest = read_json(source)
        if manifest is None:
            save(state, "resolve")
            manifest = resolve_deb(app, repository)
            write_json(source, manifest)
        try:
            artifact = download(manifest, state)
        except urllib.error.HTTPError as error:
            if error.code not in (404, 410):
                raise
            # Vendors can retire a package while an interrupted first prepare
            # still has its old source cached. Authenticate the new index once.
            save(state, "resolve")
            manifest = resolve_deb(app, repository)
            write_json(source, manifest)
            artifact = download(manifest, state)
        save(state, "install")
        installed = install_deb(app, artifact, manifest)
    return installed


def stream(*args, failure_prefix=None):
    failure = None
    with subprocess.Popen(args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True) as process:
        for line in process.stdout:
            print(safe_message(line.rstrip()), file=sys.stderr, flush=True)
            if failure_prefix and line.startswith(failure_prefix) and failure is None:
                failure = safe_message(line.rstrip())
        exit_code = process.wait()
        if failure:
            raise RuntimeError(failure)
        if exit_code:
            raise RuntimeError("Application installer failed: " + args[0])


def installed_cli():
    current = APPS / "salesforce-cli/current"
    installed = read_json(current / "manifest.json")
    if installed:
        actual = run(str(current / "node_modules/.bin/sf"), "--version").decode().strip()
        if "@salesforce/cli/" + installed["version"] + " " not in actual:
            raise RuntimeError("Persisted Salesforce CLI is not compatible with this image")
    return installed


def current_cli_release(config):
    with urllib.request.urlopen('https://registry.npmjs.org/@salesforce/cli/latest', timeout=45) as response:
        release = json.load(response)
    version = release.get('version', '')
    distribution = release.get('dist', {})
    integrity = distribution.get('integrity', '')
    expected_source = 'https://registry.npmjs.org/@salesforce/cli/-/cli-' + version + '.tgz'
    if (release.get('name') != '@salesforce/cli' or not re.fullmatch(r'[0-9]+\.[0-9]+\.[0-9]+', version)
            or distribution.get('tarball') != expected_source or not integrity.startswith('sha512-')
            or len(base64.b64decode(integrity[7:], validate=True)) != 64):
        raise RuntimeError('Unexpected Salesforce CLI release metadata from the official registry')
    return {**config, 'cliVersion': version, 'cliIntegrity': integrity, 'cliResolvedAt': now()}


def prepare_cli(config, state, update=False):
    installed = installed_cli()
    if update:
        save(state, 'resolve')
        config = current_cli_release(config)
    if installed and (not update or (installed['version'] == config['cliVersion']
                                    and installed['integrity'] == config['cliIntegrity'])):
        return installed
    root = APPS / "salesforce-cli"
    versions = root / "versions"
    versions.mkdir(parents=True, exist_ok=True)
    source = "https://registry.npmjs.org/@salesforce/cli/-/cli-" + config["cliVersion"] + ".tgz"
    artifact = CACHE / ("salesforce-cli-" + config["cliVersion"] + ".tgz")

    def authentic():
        if not artifact.is_file():
            return False
        with artifact.open("rb") as stream:
            digest = hashlib.file_digest(stream, "sha512").digest()
        return "sha512-" + base64.b64encode(digest).decode() == config["cliIntegrity"]

    if not authentic():
        save(state, "download")
        fetch(source, artifact)
    if not authentic():
        raise RuntimeError("Salesforce CLI download integrity check failed")
    save(state, "install")
    with tempfile.TemporaryDirectory(prefix=".install-", dir=versions) as temporary:
        staging = Path(temporary)
        stream("npm", "install", "--prefix", str(staging), "--no-audit", "--no-fund", "--save-exact",
               str(artifact))
        lock = read_json(staging / "package-lock.json")
        package = lock["packages"]["node_modules/@salesforce/cli"]
        if package["integrity"] != config["cliIntegrity"]:
            raise RuntimeError("Salesforce CLI integrity differs from the selected release")
        actual = run(str(staging / "node_modules/.bin/sf"), "--version").decode().strip()
        if "@salesforce/cli/" + config["cliVersion"] + " " not in actual:
            raise RuntimeError("Salesforce CLI did not report the selected version")
        installed = {"version": package["version"], "source": source,
                     "integrity": package["integrity"], "lockSha256": sha256(staging / "package-lock.json"),
                     "actualVersion": actual, "installedAt": now()}
        if 'cliResolvedAt' in config:
            installed['resolvedAt'] = config['cliResolvedAt']
        return promote(staging, root, installed, package["version"])


def extension_versions(editor):
    return sorted(line for line in run(editor, "--list-extensions", "--show-versions").decode().splitlines()
                  if "@" in line)


def extension_requirements(editor, config, versions):
    """Follow the installed vendor manifests, including nested packs/dependencies."""
    existing = {entry.lower() for entry in versions}
    identifiers = {entry.split("@", 1)[0] for entry in existing}
    required = {entry.lower() for entry in config["requiredExtensions"] + config["extensions"]}
    directories = set()
    for identifier in config["extensions"]:
        if identifier.lower() in identifiers:
            location = run(editor, "--locate-extension", identifier).decode().strip()
            if not location or not (Path(location) / "package.json").is_file():
                raise RuntimeError(editor + ": cannot locate the installed Extension Pack manifest")
            directories.add(Path(location).parent)
    manifests = {}
    for directory in directories:
        for path in directory.glob("*/package.json"):
            try:
                manifest = read_json(path)
            except json.JSONDecodeError:
                continue
            identifier = (manifest.get("publisher", "") + "." + manifest.get("name", "")).lower()
            if identifier + "@" + manifest.get("version", "").lower() in existing:
                manifests[identifier] = manifest
    pending = list(required)
    visited = set()
    while pending:
        identifier = pending.pop()
        if identifier in visited or identifier not in identifiers:
            continue
        visited.add(identifier)
        manifest = manifests.get(identifier)
        if manifest is None:
            # If the root Pack is absent, install it before inspecting its members.
            if not directories:
                continue
            raise RuntimeError(editor + ": cannot verify extension manifest: " + identifier)
        dependencies = {entry.lower() for entry in manifest.get("extensionPack", []) + manifest.get("extensionDependencies", [])}
        required.update(dependencies)
        pending.extend(dependencies - visited)
    return required


def prepare_extensions(config, state, update=False):
    previous = state["apps"].get("extensions", {})
    installed = dict(previous)
    for editor, folder in (("code", "Code"), ("code-insiders", "Code - Insiders")):
        state["app"] = editor + " extensions"
        settings = PERSONAL_HOME / ".config" / folder / "User/settings.json"
        if not settings.exists():
            write_json(settings, {"update.mode": "none", "extensions.autoCheckUpdates": False,
                                 "extensions.autoUpdate": False,
                                 "salesforcedx-vscode-apex.java.home": "/usr/lib/jvm/java-21-openjdk",
                                 "terminal.integrated.defaultProfile.linux": "zsh"})
        if update:
            save(state, 'update')
            # The editor can report an individual installation error and still
            # exit successfully. Keep this diagnostic in a known language.
            stream(editor, '--locale=en', '--update-extensions',
                   failure_prefix='Error while updating extension ')
        versions = extension_versions(editor)
        attempted = set()
        while True:
            required = extension_requirements(editor, config, versions)
            existing = {entry.split("@", 1)[0].lower() for entry in versions}
            missing = required - existing
            if not missing:
                break
            if missing & attempted:
                raise RuntimeError(editor + ": Salesforce extension installation is incomplete: " + ", ".join(sorted(missing)))
            save(state, "install")
            for extension in sorted(missing):
                stream(editor, "--install-extension", extension)
            attempted.update(missing)
            versions = extension_versions(editor)
        if editor not in installed or installed[editor]["versions"] != versions:
            installed[editor] = {"source": "https://marketplace.visualstudio.com/",
                                 "versions": versions, "installedAt": now()}
        # A second-channel failure must retain the first channel's receipt.
        state["apps"]["extensions"] = installed
        write_json(STATE, state)
    return installed


def ready(config, state):
    if state.get("state") != "completed":
        return False
    try:
        for app in config["apps"]:
            if not installed_deb(app):
                return False
        if "salesforce" in config:
            if not installed_cli():
                return False
            for editor in ("code", "code-insiders"):
                versions = extension_versions(editor)
                if not extension_requirements(editor, config["salesforce"], versions).issubset(
                        {entry.split("@", 1)[0].lower() for entry in versions}):
                    return False
    except (OSError, RuntimeError):
        return False
    return True


def prepare(config, state, update=False):
    for app in config["apps"]:
        state["app"] = app["id"]
        installed = prepare_deb(app, config["repositories"][app["repository"]], state, update=update)
        state["apps"][app["id"]] = installed
        save(state, "ready")
    if "salesforce" in config:
        state["app"] = "salesforce-cli"
        state["apps"]["salesforce-cli"] = prepare_cli(config["salesforce"], state, update=update)
        save(state, "ready")
        state["apps"]["extensions"] = prepare_extensions(config["salesforce"], state, update=update)
        state["runtime"] = {"node": run("node", "--version").decode().strip(),
                            "java": run("java", "--version").decode().strip()}
    state.update(state="completed", step="ready", updated=now())
    state.pop("app", None)
    state.pop("bytes", None)
    state.pop("totalBytes", None)
    state.pop("error", None)
    write_json(STATE, state)
    return state


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--status", action="store_true")
    parser.add_argument("--window", action="store_true", help="show first preparation in the desktop")
    parser.add_argument("--console", action="store_true", help="show a concise result in a terminal")
    parser.add_argument("--update", action="store_true", help="explicitly resolve and install current application releases")
    args = parser.parse_args()
    if args.update and (args.status or args.window):
        parser.error("--update cannot be combined with --status or --window")
    config = configuration()
    if args.window:
        existing = read_json(STATE, {})
        if ready(config, existing):
            return 0
        return subprocess.run(["konsole", "--hold", "-p", "LocalTabTitleFormat=Application preparation",
                               "-e", "workstation-apps", "--console"]).returncode
    STATE.parent.mkdir(parents=True, exist_ok=True)
    CACHE.mkdir(parents=True, exist_ok=True)
    with (STATE.parent / "preparation.lock").open("a+") as lock:
        if args.status:
            state = read_json(STATE, {"state": "pending", "step": "queued", "apps": {}})
            if "error" in state:
                state["error"] = safe_message(state["error"])
            if state["state"] == "running":
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    state.update(state="failed", error="Preparation was interrupted. Run prepare to resume.")
                except BlockingIOError:
                    pass
            print(json.dumps(state))
            return 0
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = read_json(STATE, {"state": "pending", "step": "queued", "apps": {}})
        try:
            result = prepare(config, state, update=args.update)
        except Exception as error:
            state.update(state="failed", error=safe_message(str(error)), updated=now())
            write_json(STATE, state)
            if args.update:
                print("Application update failed: " + safe_message(str(error)) +
                      ". Run update-apps to retry, or restore the backup reported by update-apps --status.",
                      file=sys.stderr)
            else:
                print("Preparation failed: " + safe_message(str(error)) + ". Run prepare to resume.", file=sys.stderr)
            if not args.console:
                print(json.dumps(state))
            return 1
        print("Applications ready.", file=sys.stderr)
        print("You can close this window." if args.console else json.dumps(result))
        return 0


if __name__ == "__main__":
    sys.exit(main())
