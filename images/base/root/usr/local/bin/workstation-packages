#!/usr/bin/env python3
"""Inventory and recover extra Arch packages using persistent personal state."""
import argparse
from contextlib import contextmanager
from datetime import datetime, timezone
import fcntl
import hashlib
import json
import os
from pathlib import Path
import pwd
import re
import subprocess
import sys
import tempfile
import urllib.parse

BASELINE = Path('/etc/electivus/image-packages.txt')
STATE = Path('/config/.local/state/electivus/packages.json')
RUNTIME = Path('/run/electivus/packages-ready')


def package_versions(text):
    return dict(line.split(' ', 1) for line in text.splitlines() if line)


def query(*args):
    return subprocess.run(['pacman', *args], check=True, text=True, capture_output=True).stdout


def installed_replacements(installed):
    database = Path(subprocess.run(['pacman-conf', 'DBPath'], check=True,
                                   text=True, capture_output=True).stdout.strip()) / 'local'
    replacements = {}
    for description in database.glob('*/desc'):
        fields = {}
        for section in description.read_text().split('\n\n'):
            lines = section.splitlines()
            if lines:
                fields[lines[0]] = lines[1:]
        names = fields.get('%NAME%', [])
        if len(names) == 1 and names[0] in installed:
            replacements[names[0]] = fields.get('%REPLACES%', [])
    return replacements


def replaces_package(declaration, name, version):
    match = re.fullmatch(r'([a-z0-9@._+][a-z0-9@._+-]*)(?:(<=|>=|=|<|>)(.+))?', declaration)
    if not match or match[1] != name:
        return False
    if not match[2]:
        return True
    comparison = int(subprocess.run(['vercmp', version, match[3]], check=True,
                                    text=True, capture_output=True).stdout.strip())
    return {'<': comparison < 0, '<=': comparison <= 0, '=': comparison == 0,
            '>=': comparison >= 0, '>': comparison > 0}[match[2]]


def image_components(saved, installed):
    baseline = package_versions(BASELINE.read_text())
    fingerprint = hashlib.sha256(BASELINE.read_bytes()).hexdigest()
    previous = saved.get('imageReplacements', {}) if saved.get('imageFingerprint') == fingerprint else {}
    declarations = installed_replacements(installed) if baseline.keys() - installed.keys() else {}
    components, replacements = [], {}
    for name, version in sorted(baseline.items()):
        component = {'name': name, 'imageVersion': version, 'installedVersion': installed.get(name),
                     'state': 'installed' if name in installed else 'missing'}
        if name not in installed:
            predecessor = previous.get(name, {'package': name, 'version': version})
            target = predecessor['package']
            if target not in installed:
                candidates = [package for package, values in declarations.items()
                              if any(replaces_package(value, target, predecessor['version']) for value in values)]
                target = candidates[0] if len(candidates) == 1 else None
            if target is not None:
                component.update(state='replaced', replacement=target, installedVersion=installed[target])
                replacements[name] = {'package': target, 'version': installed[target]}
            elif name in previous:
                # Keep the last accepted identity for a future retry, but an
                # absent successor still leaves this component missing.
                replacements[name] = predecessor
        components.append(component)
    return components, replacements, fingerprint


def inventory():
    try:
        value = json.loads(STATE.read_text())
    except FileNotFoundError:
        return {'schema': 1, 'extras': []}
    if value.get('schema') != 1 or not isinstance(value.get('extras'), list):
        raise ValueError('invalid persistent package inventory')
    return value


@contextmanager
def inventory_lock():
    STATE.parent.mkdir(parents=True, exist_ok=True)
    with open(STATE.with_name('packages.lock'), 'a+b') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def save(value):
    """Atomically replace the inventory while its caller holds inventory_lock."""
    STATE.parent.mkdir(parents=True, exist_ok=True)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode='w', dir=STATE.parent, delete=False) as stream:
            temporary = Path(stream.name)
            json.dump(value, stream, indent=2)
            stream.flush()
            os.fsync(stream.fileno())
        account = pwd.getpwnam('abc')
        os.chown(temporary, account.pw_uid, account.pw_gid)
        os.replace(temporary, STATE)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def capture(transaction=()):
    with inventory_lock():
        return capture_locked(transaction)


def capture_locked(transaction, completed_restore=None):
    installed = package_versions(query('-Q'))
    native = set(query('-Qnq').splitlines())
    explicit = set(query('-Qeq').splitlines())
    saved = inventory()
    components, replacements, fingerprint = image_components(saved, installed)
    supplied = {entry['name'] for entry in components} | {entry['package'] for entry in replacements.values()}
    if completed_restore is not None:
        saved.pop('restoringReasons', None)
        saved['lastRestore'] = completed_restore
    reasons = saved.get('restoringReasons', {})
    # A recreated container can be missing desired extras. Keep their records
    # so a fresh inventory does not erase the target of assisted recovery.
    removed = set(transaction) - installed.keys()
    extras = {entry['name']: entry for entry in saved['extras']
              if entry['name'] not in supplied and entry['name'] not in removed}
    for name, version in installed.items():
        if name not in supplied:
            extras[name] = {**extras.get(name, {}), 'name': name, 'version': version,
                            'origin': 'official' if name in native else 'foreign',
                            'reason': reasons.get(name, 'explicit' if name in explicit else 'dependency')}
    saved.update(schema=1, extras=[extras[name] for name in sorted(extras)],
                 capturedAt=datetime.now(timezone.utc).isoformat(),
                 imageFingerprint=fingerprint, imageReplacements=replacements)
    save(saved)
    return status()


def status():
    result = inventory()
    installed = package_versions(query('-Q'))
    result['imageComponents'], _, _ = image_components(result, installed)
    result['extras'] = [{**entry, 'installedVersion': installed.get(entry['name']),
                         'state': 'installed' if entry['name'] in installed else 'missing'}
                        for entry in result['extras']]
    if any(entry['state'] == 'missing' for entry in result['imageComponents']):
        result['state'] = 'image-component-failure'
    else:
        result['state'] = 'partial' if any(entry['state'] == 'missing' for entry in result['extras']) else 'ready'
    return result


def run_package_command(*args):
    # Drain the command while retaining a bounded diagnostic for the report.
    with subprocess.Popen(['workstation-network', 'exec', '--', *args],
                          stdout=subprocess.PIPE, stderr=subprocess.STDOUT) as process:
        diagnostic = b''
        for chunk in iter(lambda: process.stdout.read(8192), b''):
            diagnostic = (diagnostic + chunk)[-16384:]
        return process.wait(), diagnostic.decode('utf-8', errors='replace').strip()


def require_image_components():
    missing = [entry['name'] for entry in status()['imageComponents'] if entry['state'] == 'missing']
    if missing:
        raise RuntimeError('Supplied image components are missing: ' + ', '.join(missing))


def source_directory(directory):
    source = Path(directory).resolve(strict=True)
    if source == Path('/config') or not source.is_relative_to('/config') or not source.is_dir():
        raise ValueError('build source must be a directory inside the persistent /config volume')
    recipe = (source / 'PKGBUILD').resolve(strict=True)
    if not recipe.is_relative_to(source) or not recipe.is_file():
        raise ValueError('PKGBUILD must be a file inside the registered source directory')
    return source


def builder_command(source, *arguments):
    return ['s6-setuidgid', 'abc', 'env', 'HOME=/config', 'USER=abc', 'LOGNAME=abc',
            'PACMAN=/usr/local/bin/workstation-pacman',
            'makepkg', '--dir', str(source), *arguments]


def built_archives(source):
    code, filenames = run_package_command(*builder_command(source, '--packagelist'))
    if code:
        raise ValueError('Cannot inspect package outputs: ' + filenames)
    packages = {}
    for filename in filenames.splitlines():
        archive = Path(filename)
        if not archive.is_file():
            continue
        metadata = subprocess.run(['pacman', '-Qp', '--', str(archive)], capture_output=True, text=True)
        if metadata.returncode == 0:
            packages.setdefault(metadata.stdout.split()[0], []).append(str(archive))
    return packages


def require_foreign_extra(saved, name):
    if not any(entry['name'] == name and entry['origin'] == 'foreign' for entry in saved['extras']):
        raise ValueError('source registration requires a recorded AUR/local extra package')


def register_source(name, directory):
    if not name or not re.fullmatch(r'[a-z0-9@._+][a-z0-9@._+-]*', name):
        raise ValueError('a valid extra package name is required')
    source = source_directory(directory)
    capture()
    require_foreign_extra(inventory(), name)
    remote = subprocess.run(['s6-setuidgid', 'abc', 'git', '-C', str(source), 'remote', 'get-url', 'origin'],
                            capture_output=True, text=True)
    origin = remote.stdout.strip() if remote.returncode == 0 else ''
    url = urllib.parse.urlsplit(origin)
    kind = 'aur' if url.scheme in {'https', 'ssh'} and url.hostname == 'aur.archlinux.org' else 'local'
    outputs = built_archives(source)
    # Source evaluation can be slow and can run package commands itself. Keep it
    # outside the lock, then update the latest records as one critical section.
    with inventory_lock():
        saved = inventory()
        require_foreign_extra(saved, name)
        for candidate in saved['extras']:
            if candidate['origin'] == 'foreign' and (candidate['name'] == name or candidate['name'] in outputs):
                candidate['source'] = {'directory': str(source), 'kind': kind}
        save(saved)
    return status()


def rebuild(entry, builds, desired):
    result = {'name': entry['name'], 'origin': entry['origin'], 'method': 'rebuilt'}
    try:
        source = source_directory(entry['source']['directory'])
    except (KeyError, OSError, ValueError) as error:
        return {**result, 'state': 'manual-required', 'diagnostic': str(error)}
    if source not in builds:
        code, diagnostic = run_package_command(*builder_command(source, '--force', '--cleanbuild', '--syncdeps', '--noconfirm'))
        if code:
            builds[source] = {'diagnostic': diagnostic}
        else:
            try:
                builds[source] = {'archives': built_archives(source)}
            except ValueError as error:
                builds[source] = {'diagnostic': str(error)}
    build = builds[source]
    if 'diagnostic' in build:
        return {**result, 'state': 'build-failed', 'diagnostic': build['diagnostic']}
    matching = build['archives'].get(entry['name'], [])
    if len(matching) != 1:
        return {**result, 'state': 'build-failed', 'diagnostic': 'Build did not produce exactly one archive for the recorded package.'}
    if 'installation' not in build:
        related = {entry['name']}
        for candidate in desired:
            if candidate['origin'] == 'official' or not candidate.get('source'):
                continue
            try:
                if source_directory(candidate['source']['directory']) == source:
                    related.add(candidate['name'])
            except (KeyError, OSError, ValueError):
                continue
        archives = [build['archives'][name][0] for name in sorted(related)
                    if len(build['archives'].get(name, [])) == 1]
        # Split packages can depend on each other, including in cycles. Pacman
        # must resolve their recorded outputs in one transaction. Saved reasons
        # are reconciled for all extras after installation, as for official ones.
        build['installation'] = run_package_command('pacman', '-U', '--noconfirm', '--', *archives)
    code, diagnostic = build['installation']
    installed = package_versions(query('-Q'))
    if code or entry['name'] not in installed:
        return {**result, 'state': 'missing', 'diagnostic': diagnostic}
    return {**result, 'state': 'restored', 'installedVersion': installed[entry['name']]}


def restore_reasons(desired):
    # Installing one extra may pull another desired extra in as a dependency.
    # Reconcile intent after all installations, including packages skipped as
    # already present, before capture records the final package database.
    installed = package_versions(query('-Q'))
    for reason, option in [('explicit', '--asexplicit'), ('dependency', '--asdeps')]:
        names = sorted({entry['name'] for entry in desired
                        if entry['name'] in installed and entry.get('reason') == reason})
        if names:
            code, diagnostic = run_package_command('pacman', '-D', option, '--', *names)
            if code:
                raise RuntimeError('Could not restore saved package installation reasons: ' + diagnostic)


def restore():
    require_image_components()
    with inventory_lock():
        saved = inventory()
        reasons = saved.get('restoringReasons', {})
        desired = [{**entry, 'reason': reasons.get(entry['name'], entry.get('reason', 'explicit'))}
                   for entry in saved['extras']]
        # Hooks run between restoration transactions. Preserve the user's
        # intent before the first one, including across failure and recreation.
        saved['restoringReasons'] = {entry['name']: entry['reason'] for entry in desired}
        save(saved)
    code, diagnostic = run_package_command('pacman', '-Syu', '--needed', '--noconfirm',
                                           '--disable-download-timeout', '--noprogressbar')
    if code:
        raise RuntimeError('Arch base upgrade failed: ' + diagnostic)
    results = []
    builds = {}
    for entry in desired:
        name = entry['name']
        result = {'name': name, 'origin': entry['origin']}
        before = package_versions(query('-Q'))
        if entry['origin'] != 'official':
            if entry.get('source'):
                result = rebuild(entry, builds, desired)
            else:
                result.update(state='manual-required', diagnostic='Register the persistent build source before restoring this package.')
        elif name in before:
            result.update(state='installed', installedVersion=before[name])
        else:
            reason = ['--asdeps'] if entry.get('reason') == 'dependency' else []
            code, diagnostic = run_package_command('pacman', '-S', '--needed', '--noconfirm',
                                                   '--disable-download-timeout', '--noprogressbar', *reason, '--', name)
            installed = package_versions(query('-Q'))
            if code or name not in installed:
                result.update(state='missing', diagnostic=diagnostic)
            else:
                result.update(state='restored', installedVersion=installed[name])
        results.append(result)
    restore_reasons(desired)
    require_image_components()
    report = {'state': 'completed' if all(entry['state'] in {'restored', 'installed'} for entry in results) else 'partial',
              'packages': results, 'completedAt': datetime.now(timezone.utc).isoformat()}
    with inventory_lock():
        # Clear the pending intent together with the completed capture/report.
        # A failed query or write keeps the durable intent for another attempt.
        capture_locked((), completed_restore=report)
    return report


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['status', 'capture', 'transaction', 'restore', 'register'])
    parser.add_argument('--package')
    parser.add_argument('--source')
    args = parser.parse_args()
    if args.action == 'transaction':
        # The base hook is inherited during Salesforce builds. Only initialized
        # workstations have personal state to update after a package transaction.
        if RUNTIME.exists():
            capture(sys.stdin.read().splitlines())
        return
    actions = {'capture': capture, 'restore': restore, 'status': status,
               'register': lambda: register_source(args.package, args.source)}
    print(json.dumps(actions[args.action]()))


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print('Extra package operation failed: ' + str(error), file=sys.stderr)
        sys.exit(1)
