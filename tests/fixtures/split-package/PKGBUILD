pkgbase=workstation-pair-example
pkgname=('workstation-pair-first' 'workstation-pair-second')
pkgver=1.0
pkgrel=1
pkgdesc='Acceptance fixture with mutually dependent split packages'
arch=('x86_64')
license=('MIT')
options=('!debug')
makedepends=('gcc')
source=('example.c')
sha256sums=('ab170c28457323363bc10f1a79ad08fc82e67976b5f09eef7a43becafb485bfd')

build() {
    cc -O2 example.c -o workstation-pair-example
}

package_workstation-pair-first() {
    depends=('workstation-pair-second=1.0')
    install -Dm755 workstation-pair-example "$pkgdir/usr/bin/workstation-pair-first"
}

package_workstation-pair-second() {
    depends=('workstation-pair-first=1.0')
    install -Dm755 workstation-pair-example "$pkgdir/usr/bin/workstation-pair-second"
}
